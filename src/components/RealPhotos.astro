---
// Fotos reais da equipe e dos atendimentos (as que o cliente tem hoje).
import { Image } from 'astro:assets';
import { fotoDoServico } from '../data/fotos';

const fotos = [
  { foto: fotoDoServico('equipe'), legenda: 'Equipe Elite' },
  { foto: fotoDoServico('conserto-de-geladeira'), legenda: 'Conserto de geladeira', href: '/servicos/conserto-de-geladeira/' },
  { foto: fotoDoServico('troca-de-compressor'), legenda: 'Troca de compressor', href: '/servicos/troca-de-compressor/' },
].filter((f) => f.foto);
---

<div class="real-photos">
  {
    fotos.map(({ foto, legenda, href }) => (
      <figure>
        {href ? (
          <a href={href}>
            <Image src={foto!.src} alt={foto!.alt} widths={[400, 700, 1000]} sizes="(max-width: 800px) 100vw, 480px" />
            <figcaption>{legenda}</figcaption>
          </a>
        ) : (
          <>
            <Image src={foto!.src} alt={foto!.alt} widths={[400, 700, 1000]} sizes="(max-width: 800px) 100vw, 560px" />
            <figcaption>{legenda}</figcaption>
          </>
        )}
      </figure>
    ))
  }
</div>
