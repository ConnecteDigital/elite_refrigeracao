---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { site } from '../../data/site';
import { servicos } from '../../data/servicos';
import { breadcrumbSchema } from '../../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos/' },
];
---

<Base
  title={`Serviços de Refrigeração em Fortaleza 24h | ${site.name}`}
  description="Conserto de geladeira, freezer e câmara fria em Fortaleza: compressor, carga de gás com laudo, solda, termostato, resistência e vedação. Atendimento 24h."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Serviços</span>
      <h1>Serviços de refrigeração em Fortaleza</h1>
      <p class="hero-lead">Geladeira, freezer e câmara fria, para casa e comércio. 24 horas, chegada em até {site.arrivalMinutes} minutos, visita grátis e {site.warrantyDays} dias de garantia.</p>
      <CtaButtons />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
