  <section class="hero page-hero">
    <div class="container">
      <h1>Página não encontrada</h1>
      <p class="hero-lead">Essa página não existe, mas a sua geladeira tem conserto. Fale com a gente ou <a href="/" style="color:var(--yellow)">volte ao início</a>.</p>
      <CtaButtons />
    </div>
  </section>
</Base>
